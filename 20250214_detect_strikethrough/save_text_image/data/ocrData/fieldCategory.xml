<?xml version="1.0" encoding="utf-8" standalone="yes"?>

<IzFormOcrFieldCategory>

	<!--
		- Type: 타입정보. OCR필드가 아닌 분석해서 판단한 정보를 의미함.
			- DocumentType: 문서타입
			- Verified: 필드 유효성정보

		- Region: 영역정보
			- Picture: 사진 영역
			- Masking: 마스킹 영역
			- DocumentBoundary: 문서 영역 (인식 정보를 바탕으로 추정한 문서경계영역)

		- NormalTest: 일반문자열
			- Digit: 숫자만 존재하는 문자열
			- Alpha: 영문알파벳만 존재하는 문자열
			- Hangul: 한글만 존재하는 문자열
			- Hanja: 한자만 존재하는 문자열

		- Date: 날짜
			- YYYY년 MM월 DD일
			- YYYY-MM-DD
			- YYYY/MM/DD
			- YYYY.MM.DD
			- YYYYMMDD

		- Currency: 통화

		- Korean
			- Name: 한국 이름
				- Hangul
				- Hanja
				- English
			- Address: 한국 주소
				- Hangul
				- English
			- ResidentRegistrationNumber: 한국 주민등록번호
			- BusinessRegistrationNumber: 한국 법인등록번호

		- Company: 회사명

		- Tel: 전화번호

		- Etc : 기타 (default)
	-->

	<!-- idNumber 구조
		4자리: 라이브러리 코드 (범용인식: 0101)
		3자리: 카테고리 구분 코드
		3자리: 하위 카테고리 일련번호
	-->

